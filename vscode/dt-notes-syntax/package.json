{
  "name": "dt-notes-syntax",
  "displayName": "DT Notes Syntax",
  "description": "Editing help for DT Notes pages: a live preview of animations, slides and flash cards, plus highlighting, error marks and colour swatches for animation scenes.",
  "version": "1.10.5",
  "publisher": "dt-notes",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/waimea-dt/dt-notes"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:anim",
    "onLanguage:markdown",
    "onCommand:dtNotes.previewBlock"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dtNotes.previewBlock",
        "title": "Preview Block",
        "category": "DT Notes",
        "icon": "$(play-circle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dtNotes.previewBlock",
          "when": "editorLangId == markdown || editorLangId == anim",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dtNotes.previewBlock",
          "when": "editorLangId == markdown || editorLangId == anim"
        }
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "configuration": {
      "title": "DT Notes Syntax",
      "properties": {
        "dtNotes.blockBackground": {
          "type": "string",
          "default": "rgba(255, 255, 255, 0.04)",
          "description": "Background tint for plugin blocks in Markdown, such as <animation>…</animation> (any CSS colour; empty for none)."
        },
        "dtNotes.shadedBlocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "animation", "slides", "quiz", "flashcards", "drag-drop", "primm", "web-playground",
            "cards", "menu", "computer", "img-notes", "coming-soon",
            "filetree", "hierarchy", "structure", "sequence", "timeline", "requests",
            "db-schema", "db-data", "erd", "accessibility", "calculator"
          ],
          "description": "The plugin block tags to shade (a block is shaded when its closing tag is on a later line)."
        }
      }
    },
    "languages": [
      {
        "id": "anim",
        "aliases": [
          "Anim",
          "anim"
        ],
        "extensions": [
          ".anim"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "anim",
        "scopeName": "source.anim",
        "path": "./syntaxes/anim.tmLanguage.json"
      },
      {
        "scopeName": "markdown.anim.codeblock",
        "path": "./syntaxes/anim-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.anim": "anim"
        }
      }
    ]
  }
}
