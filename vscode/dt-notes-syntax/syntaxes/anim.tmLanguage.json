{
  "$comment": "Scene lines for <animation> blocks: see docs/_plugins/visualisation/ANIMATION.md. Three roles: commands (keyword, and a shape type straight after id:), params (support.type.property-name: named ones like speed, and standalone ones like bold, pop, dashed) and their values (support.constant.property-value, numbers, colours, strings, ids). See CLAUDE-ANIMATION.md.",
  "name": "Anim",
  "scopeName": "source.anim",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#line-head"
    },
    {
      "include": "#beat-line"
    },
    {
      "include": "#resource"
    },
    {
      "include": "#action"
    },
    {
      "include": "#highlight"
    },
    {
      "include": "#ease"
    },
    {
      "include": "#speed"
    },
    {
      "include": "#align"
    },
    {
      "include": "#lang"
    },
    {
      "include": "#shape-type"
    },
    {
      "include": "#property"
    },
    {
      "include": "#flag"
    },
    {
      "include": "#value"
    },
    {
      "include": "#literal"
    },
    {
      "include": "#colour"
    },
    {
      "include": "#number"
    },
    {
      "include": "#shape-ref"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "$comment": "# followed by a space (or the end of the line) starts a comment; #f80 is a colour",
      "name": "comment.line.number-sign.anim",
      "match": "(?:^|(?<=\\s))#(?=\\s|$).*$"
    },
    "string": {
      "name": "string.quoted.double.anim",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.anim",
          "match": "\\\\."
        }
      ]
    },
    "line-head": {
      "$comment": "id: at the start of a line, and a shape type straight after it (elsewhere arrow is the arrowhead param)",
      "match": "^\\s*([A-Za-z][\\w.-]*)\\s*(:)(?:\\s*(rect|circle|diamond|text|line|arrow|curve|row|column|code|var)(?![\\w-]))?",
      "captures": {
        "1": {
          "name": "entity.name.tag.anim"
        },
        "2": {
          "name": "punctuation.separator.key-value.anim"
        },
        "3": {
          "name": "storage.type.anim"
        }
      }
    },
    "beat-line": {
      "$comment": "lines with no id; defaults clear and camera reset are commands too, like clear everywhere",
      "match": "^\\s*(defaults|camera|pause|auto)(?![\\w-])(?:\\s+(clear|reset)(?![\\w-]))?",
      "captures": {
        "1": {
          "name": "keyword.control.anim"
        },
        "2": {
          "name": "keyword.control.anim"
        }
      }
    },
    "resource": {
      "match": "(?<![\\w-])(image|icon)(\\()([^)]*)(\\))",
      "captures": {
        "1": {
          "name": "storage.type.anim"
        },
        "2": {
          "name": "punctuation.definition.arguments.begin.anim"
        },
        "3": {
          "name": "string.unquoted.anim"
        },
        "4": {
          "name": "punctuation.definition.arguments.end.anim"
        }
      }
    },
    "action": {
      "$comment": "the verbs: words that start a line's command, and the actions detach (like ungroup) and clear (callout clear, name clear, indices clear; highlight clear is in its own rule)",
      "name": "keyword.control.anim",
      "match": "(?<![\\w-])(copy|group|ungroup|delete|swap|insert|remove|detach|clear)(?![\\w-])"
    },
    "ease": {
      "$comment": "ease and its value (in and out are only values here)",
      "match": "(?<![\\w-])(ease)(?:\\s+(in-out|linear|in|out|spring)(?![\\w-]))?",
      "captures": {
        "1": {
          "name": "support.type.property-name.anim"
        },
        "2": {
          "name": "support.constant.property-value.anim"
        }
      }
    },
    "highlight": {
      "$comment": "highlight and its words (outline, inside, line, spotlight, arrow, number N, clear), so arrow and line here aren't shape types",
      "match": "(?<![\\w-])(highlight)((?:\\s+(?:outline|inside|line|spotlight|arrow|glow|clear|number(?:\\s+[+-]?(?:\\d+\\.?\\d*|\\.\\d+))?)(?![\\w-]))*)",
      "captures": {
        "1": {
          "name": "support.type.property-name.anim"
        },
        "2": {
          "patterns": [
            {
              "name": "keyword.control.anim",
              "match": "(?<![\\w-])clear(?![\\w-])"
            },
            {
              "name": "support.constant.property-value.anim",
              "match": "(?<![\\w-])(outline|inside|line|spotlight|arrow|glow|number)(?![\\w-])"
            },
            {
              "include": "#number"
            }
          ]
        }
      }
    },
    "speed": {
      "$comment": "speed and its word (normal is a value here, the layer param elsewhere)",
      "match": "(?<![\\w-])(speed)(?:\\s+(instant|vfast|fast|normal|slow|vslow)(?![\\w-]))?",
      "captures": {
        "1": {
          "name": "support.type.property-name.anim"
        },
        "2": {
          "name": "support.constant.property-value.anim"
        }
      }
    },
    "lang": {
      "$comment": "lang and a code block's language (any word: Prism's name for it)",
      "match": "(?<![\\w-])(lang)(?:\\s+([A-Za-z][\\w+#-]*))?",
      "captures": {
        "1": {
          "name": "support.type.property-name.anim"
        },
        "2": {
          "name": "support.constant.property-value.anim"
        }
      }
    },
    "align": {
      "match": "(?<![\\w-])(align)(?:\\s+(left|centre|right)(?![\\w-]))?",
      "captures": {
        "1": {
          "name": "support.type.property-name.anim"
        },
        "2": {
          "name": "support.constant.property-value.anim"
        }
      }
    },
    "shape-type": {
      "$comment": "a shape type starting a continuation line (an indented line of a long command)",
      "match": "^\\s+(rect|circle|diamond|text|line|arrow|curve|row|column|code|var)(?![\\w-])",
      "captures": {
        "1": {
          "name": "storage.type.anim"
        }
      }
    },
    "property": {
      "$comment": "named params, which a value follows",
      "name": "support.type.property-name.anim",
      "match": "(?<![\\w-])(at|move|goto|x|y|from|to|via|gap|travel|follow-reverse|follow|attach|size|width|height|radius|corner|fill|stroke|colour|weight|font|angle|scale|delay|stagger-reverse|stagger|highlight|callout|name|indices|numbered|zoom|into|above|below|left-of|right-of)(?![\\w-])"
    },
    "flag": {
      "$comment": "standalone params: a word that sets something on its own (looks, effects, emphasis, an arrowhead)",
      "name": "support.type.property-name.anim",
      "match": "(?<![\\w-])(keep-style|bold|mono|solid|dashed|dotted|flow-reverse|flow|static|back|normal|front|fade|pop|draw|slide|typed|pulse|shake|wobble|wiggle|bounce|glow|signal-reverse|signal|arrow)(?![\\w-])"
    },
    "value": {
      "$comment": "value words, after a param (highlight, speed, align and ease values have their own rules)",
      "name": "support.constant.property-value.anim",
      "match": "(?<![\\w-])(outline|inside|spotlight)(?![\\w-])"
    },
    "literal": {
      "$comment": "words that stand in for a value, like a number does: end (a row's last place) and null (no value). Also a named constant (variable.other.constant), the innermost scope, so themes that colour language constants like an error (Catppuccin: red) show them as constants (peach, like numbers and true)",
      "name": "constant.language.anim variable.other.constant.anim",
      "match": "(?<![\\w-])(end|null)(?![\\w-])"
    },
    "colour": {
      "patterns": [
        {
          "name": "constant.other.color.anim",
          "match": "#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})(?![\\w])"
        },
        {
          "name": "support.constant.color.anim",
          "match": "(?<![\\w-])(red|orange|amber|yellow|green|teal|cyan|blue|purple|pink|magenta|theme|muted|fg|bg|black|white|none)(?![\\w-])"
        }
      ]
    },
    "number": {
      "$comment": "numbers, and sizes like 2x1 (the x is a separator, like the comma in 2,1). A signed number is relative on a change (move +2,0): constant.numeric.relative (for a colour of its own in editor.tokenColorCustomizations), its sign an operator. When creating, a signed number is absolute, but the grammar can't tell.",
      "match": "(?<![\\w.])(?:([+-](?:\\d+\\.?\\d*|\\.\\d+))|(\\d+\\.?\\d*|\\.\\d+))(?:([xX\u00d7])(?:([+-](?:\\d+\\.?\\d*|\\.\\d+))|(\\d+\\.?\\d*|\\.\\d+)))?(?![\\w.])",
      "captures": {
        "1": {
          "name": "constant.numeric.relative.anim",
          "patterns": [
            {
              "include": "#relative"
            }
          ]
        },
        "2": {
          "name": "constant.numeric.anim"
        },
        "3": {
          "name": "punctuation.separator.anim"
        },
        "4": {
          "name": "constant.numeric.relative.anim",
          "patterns": [
            {
              "include": "#relative"
            }
          ]
        },
        "5": {
          "name": "constant.numeric.anim"
        }
      }
    },
    "relative": {
      "$comment": "inside a signed number: the sign, then the number",
      "patterns": [
        {
          "name": "keyword.operator.sign.anim",
          "match": "[+-]"
        },
        {
          "name": "constant.numeric.relative.anim",
          "match": "\\d+\\.?\\d*|\\.\\d+"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.anim",
          "match": ","
        },
        {
          "$comment": "a row's / column's [values]",
          "name": "punctuation.section.brackets.anim",
          "match": "[\\[\\]]"
        }
      ]
    },
    "shape-ref": {
      "$comment": "any other word is a shape id used as a value (from a to b, attach right-of msg, travel r1 r2); keep this last",
      "name": "variable.parameter.anim",
      "match": "(?<![\\w#.-])[A-Za-z][\\w.-]*(?![\\w-])"
    }
  }
}
